<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <TextView android:id="@+id/tvDay" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="@color/ink" android:textStyle="bold" />
    <TextView android:id="@+id/tvTime" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="@color/muted" />
    <TextView android:id="@+id/tvClass" android:layout_width="0dp" android:layout_weight="1.2" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="@color/ink" />

</LinearLayout>
