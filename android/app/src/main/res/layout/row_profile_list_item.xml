<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="12dp"
    android:paddingBottom="16dp">

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/line" android:layout_marginBottom="12dp" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="10dp">
        <ImageView android:id="@+id/imgSelfie" android:layout_width="56dp" android:layout_height="56dp"
            android:background="@drawable/bg_avatar" android:scaleType="centerCrop" android:layout_marginEnd="14dp" />
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/tvName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="16sp" android:textStyle="bold" android:textColor="@color/ink" />
            <TextView android:id="@+id/tvMeta" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="@color/muted" />
        </LinearLayout>
        <TextView android:id="@+id/tvGradeBadge" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/white" android:background="@drawable/bg_badge"
            android:paddingHorizontal="12dp" android:paddingVertical="4dp" android:textSize="12sp" android:textStyle="bold" />
    </LinearLayout>

    <TextView android:id="@+id/tvPills" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/ink" android:textSize="12sp" android:lineSpacingExtra="3dp" android:layout_marginBottom="10dp" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <Button android:id="@+id/btnEdit" style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp" android:layout_marginEnd="8dp"
            android:text="Edit" android:textAllCaps="false" />
        <Button android:id="@+id/btnDelete" style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp"
            android:text="Delete" android:textAllCaps="false" android:textColor="@color/red" app:strokeColor="@color/red" />
    </LinearLayout>

</LinearLayout>
